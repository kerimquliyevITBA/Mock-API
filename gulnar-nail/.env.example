# Supabase (Session pooler recommended for Railway)
# Example: jdbc:postgresql://aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=jdbc:postgresql://HOST:5432/postgres
DB_USERNAME=postgres.YOURPROJECT
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SCHEMA=gulnar

# JWT — must be at least 32 chars for HS256
JWT_SECRET=change-me-please-change-me-please-32chars-min
JWT_TTL_HOURS=8

# First-run admin (created only if user does not exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
ADMIN_NAME=Administrator

# Comma-separated origins for the HTML frontend, or "*" during development
CORS_ORIGINS=*

# Set to false in production if you don't want demo services + open days
SEED_DEMO=true

# Railway sets PORT automatically
PORT=8080
