# ---------------------------------------------------------------------------
# Room Reservation API — environment configuration
# Copy real values into Railway -> Service -> Variables (do NOT commit secrets).
# ---------------------------------------------------------------------------

# Supabase Postgres connection (Project -> Settings -> Database -> Connection string).
# Prefer the DIRECT connection (port 5432); SSL is required, so keep sslmode=require.
# Example:
#   jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=<your-supabase-db-password>

# HTTP port — Railway injects PORT automatically; only set locally if needed.
# PORT=8080
